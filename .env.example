# Optional: copy to .env to change these defaults (docker compose reads it automatically)

# Port on localhost for the app: http://localhost:8765
PORT=8765

# HTTP(S) proxy for NBA requests, only needed if stats.nba.com doesn't answer your IP
# NBA_API_PROXY=http://user:pass@host:port

# Seconds to wait for one NBA response, and pause between requests (stats.nba.com throttles)
NBA_TIMEOUT=30
NBA_REQUEST_DELAY=0.6

# Play-by-play exports refuse more games than this (a regular season is 1230)
MAX_GAMES=1500

# How long finished exports stay downloadable
EXPORT_TTL_HOURS=24
